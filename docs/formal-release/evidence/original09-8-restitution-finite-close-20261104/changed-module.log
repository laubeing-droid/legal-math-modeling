      (∀ e ∈ events ++ [fresh],
          ∀ (a : A),
            delta e a =
              (if party a = e.event.payee then e.event.amount.value else 0) -
                if party a = e.event.payer then e.event.amount.value else 0) ∧
        ∑ a, Ledger.cashVector (List.map delta (events ++ [fresh])) a = 0
