  (r : RefundRule) (h : Ready base.gamma extract base.state decision r) (events : List (BookedCash A party))
  (fresh : BookedCash A party)
  (hcomplete : List.map (fun x => x.event) events = base.state.cash ++ base.state.refundCash)
  (hfresh : fresh.event = cashFromPayload r.payment.payload)
  (hunit : ∀ e ∈ events, e.event.amount.tag = r.payment.payload.amount.tag) :
  Stages base.state r ∧
    checkedEffect base.gamma extract base.state decision r = some (effectPair base.state r) ∧
      QuantityConclusion base.state r ∧
        List.map (fun x => x.event) (events ++ [fresh]) =
