{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laubeing-droid/legal-math-modeling/schemas/formal-release-certificate-v1.json",
  "title": "FormalReleaseCertificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "subject",
    "environment",
    "inputs",
    "source_inventory",
    "gates",
    "trusted_axiom_basis",
    "limitations",
    "certificate_digest"
  ],
  "properties": {
    "schema_version": { "const": "formal-release-certificate-v1" },
    "status": {
      "enum": [
        "FORMAL_RELEASE_VERIFIED",
        "SOURCE_INVENTORY_NOT_RELEASE_CERTIFICATE"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "dirty"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": "boolean" }
      }
    },
    "environment": { "type": "object" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "source_inventory": { "type": "object" },
    "gates": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "gate_id",
          "commands",
          "exit_code",
          "started_at",
          "finished_at",
          "status",
          "raw_log",
          "raw_log_sha256",
          "raw_log_size_bytes"
        ]
      }
    },
    "trusted_axiom_basis": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "certificate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
