/-- Integrate an arbitrary real-valued outcome over the actual Bernoulli law. -/
theorem bernoulli_expected_value (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (f : Bool → ℝ) :
    (∫ o, f o ∂bernoulliMeasure q hq0 hq1) = q * f true + (1 - q) * f false := by
  have hnn : q.toNNReal ≤ 1 := by
    change (q.toNNReal : ℝ) ≤ (1 : ℝ)
    rw [Real.coe_toNNReal q hq0]
    exact hq1
  unfold bernoulliMeasure
  rw [PMF.integral_eq_sum]
  simp [Fintype.sum_bool, PMF.bernoulli_apply,
    NNReal.coe_sub hnn, NNReal.coe_one,
    Real.coe_toNNReal q hq0, smul_eq_mul] <;> ring

/-- Cash in the success/failure branches, after one common cost is charged. -/
def cashOutcome (outcome : Bool) (success failure commonCost : ℝ) : ℝ :=
  (if outcome then success else failure) - commonCost

theorem bernoulli_expected_cash (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (success failure commonCost : ℝ) :
    (∫ outcome, cashOutcome outcome success failure commonCost
      ∂bernoulliMeasure q hq0 hq1) = Decision.net q success failure commonCost := by
  rw [bernoulli_expected_value q hq0 hq1 (cashOutcome · success failure commonCost)]
  simp [cashOutcome, Decision.net] <;> ring

/-- Branch costs are already included in their branch net amounts; the shared
cost is subtracted once from either outcome. -/
theorem branch_costs_paid_once (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (grossSuccess successCost grossFailure failureCost commonCost : ℝ) :
    (∫ outcome, cashOutcome outcome (grossSuccess - successCost)
      (grossFailure - failureCost) commonCost ∂bernoulliMeasure q hq0 hq1) =
      Decision.net q (grossSuccess - successCost) (grossFailure - failureCost)
        commonCost :=
  bernoulli_expected_cash q hq0 hq1 (grossSuccess - successCost)
    (grossFailure - failureCost) commonCost

/-- Expected cash generated by selected, identity-disjoint success/failure
event sets and a common set, using the existing real cash ledger projection. -/
theorem expected_cash_from_event_sets (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (entries : List RealCashEvent)
    (success failure common : Finset RealCashEvent) (party : PartyId)
    (successSelected : ∀ e ∈ success, e ∈ entries)
    (failureSelected : ∀ e ∈ failure, e ∈ entries)
    (commonSelected : ∀ e ∈ common, e ∈ entries)
    (eventIdsNodup : (entries.map RealCashEvent.id).Nodup)
    (successCommonDisjoint : Disjoint
      (success.image RealCashEvent.id) (common.image RealCashEvent.id))
    (failureCommonDisjoint : Disjoint
      (failure.image RealCashEvent.id) (common.image RealCashEvent.id))
    (unitTag : AmountTag) (sameUnit : ∀ e ∈ entries, e.tag = unitTag) :
    (∫ outcome, netCash ((if outcome then success else failure) ∪ common) party
      ∂bernoulliMeasure q hq0 hq1) =
      Decision.net q (netCash success party) (netCash failure party)
        (-netCash common party) := by
  have branchCash : ∀ outcome,
      netCash ((if outcome then success else failure) ∪ common) party =
        cashOutcome outcome (netCash success party) (netCash failure party)
          (-netCash common party) := by
    intro outcome
    cases outcome
    · simpa [cashOutcome] using disjoint_id_cash_additive entries failure common party
        failureSelected commonSelected eventIdsNodup failureCommonDisjoint
    · simpa [cashOutcome] using disjoint_id_cash_additive entries success common party
        successSelected commonSelected eventIdsNodup successCommonDisjoint
  calc
    _ = ∫ outcome, cashOutcome outcome (netCash success party)
          (netCash failure party) (-netCash common party)
          ∂bernoulliMeasure q hq0 hq1 := by
        apply integral_congr_ae
        exact Filter.Eventually.of_forall branchCash
    _ = Decision.net q (netCash success party) (netCash failure party)
          (-netCash common party) :=
        bernoulli_expected_cash q hq0 hq1 _ _ _

/-- Utility receives cash through an explicit wealth argument and noncash
outcomes through a separate explicit mapping. -/
theorem bernoulli_utility_two_branch (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (utility : ℝ → ℝ) (wealth success failure commonCost : ℝ)
    (noncash : Bool → ℝ) :
    (∫ outcome, utility (wealth + cashOutcome outcome success failure commonCost) +
      noncash outcome ∂bernoulliMeasure q hq0 hq1) =
      q * (utility (wealth + (success - commonCost)) + noncash true) +
        (1 - q) * (utility (wealth + (failure - commonCost)) + noncash false) := by
  rw [bernoulli_expected_value q hq0 hq1
    (fun outcome => utility (wealth + cashOutcome outcome success failure commonCost) +
      noncash outcome)]
  simp [cashOutcome]

/-- Under a shared linear risk-neutral utility and fixed noncash consequence,
actual expected utility is the affine image of expected net cash. -/
theorem linear_risk_neutral_expected_utility (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (slope offset wealth success failure commonCost noncash : ℝ) :
    (∫ outcome, (slope * (wealth + cashOutcome outcome success failure commonCost) +
      offset + noncash) ∂bernoulliMeasure q hq0 hq1) =
      slope * (wealth + Decision.net q success failure commonCost) + offset + noncash := by
  rw [bernoulli_expected_value q hq0 hq1
    (fun outcome => slope * (wealth + cashOutcome outcome success failure commonCost) +
      offset + noncash)]
  simp [cashOutcome, Decision.net] <;> ring

/-- With the same wealth, slope, offset, and noncash consequence, comparing two
linear risk-neutral actions is equivalent to comparing their expected cash. -/
theorem linear_risk_neutral_action_order_iff
    (q1 : ℝ) (hq10 : 0 ≤ q1) (hq11 : q1 ≤ 1)
    (q2 : ℝ) (hq20 : 0 ≤ q2) (hq21 : q2 ≤ 1)
    (slope offset wealth commonNoncash success1 failure1 cost1 success2 failure2 cost2 : ℝ)
    (slopePositive : 0 < slope) :
    (∫ outcome, (slope * (wealth + cashOutcome outcome success1 failure1 cost1) +
      offset + commonNoncash) ∂bernoulliMeasure q1 hq10 hq11) ≤
      (∫ outcome, (slope * (wealth + cashOutcome outcome success2 failure2 cost2) +
        offset + commonNoncash) ∂bernoulliMeasure q2 hq20 hq21) ↔
      Decision.net q1 success1 failure1 cost1 ≤ Decision.net q2 success2 failure2 cost2 := by
  rw [linear_risk_neutral_expected_utility q1 hq10 hq11 slope offset wealth
      success1 failure1 cost1 commonNoncash,
    linear_risk_neutral_expected_utility q2 hq20 hq21 slope offset wealth
      success2 failure2 cost2 commonNoncash]
  change (slope * (wealth + Decision.net q1 success1 failure1 cost1) + offset + commonNoncash ≤
      slope * (wealth + Decision.net q2 success2 failure2 cost2) + offset + commonNoncash) ↔
      Decision.net q1 success1 failure1 cost1 ≤ Decision.net q2 success2 failure2 cost2
  constructor
  · intro h
    have hmul : slope * Decision.net q1 success1 failure1 cost1 ≤
        slope * Decision.net q2 success2 failure2 cost2 := by
      nlinarith [h]
    exact (mul_le_mul_iff_of_pos_left slopePositive).mp hmul
  · intro h
    have hmul := (mul_le_mul_iff_of_pos_left slopePositive).mpr h
    nlinarith

/-- For a zero-success-baseline offer with b>0, the existing threshold theorem
gives the exact risk-neutral acceptance condition k/b ≤ q. -/
theorem linear_risk_neutral_threshold_iff (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (slope offset wealth commonNoncash b k : ℝ)
    (slopePositive : 0 < slope) (bPositive : 0 < b) :
    (∫ outcome, (slope * (wealth + cashOutcome outcome 0 0 0) + offset + commonNoncash)
      ∂bernoulliMeasure q hq0 hq1) ≤
      (∫ outcome, (slope * (wealth + cashOutcome outcome b 0 k) +
        offset + commonNoncash) ∂bernoulliMeasure q hq0 hq1) ↔
      k / b ≤ q := by
  rw [linear_risk_neutral_action_order_iff q hq0 hq1 q hq0 hq1
    slope offset wealth commonNoncash
    0 0 0 b 0 k slopePositive]
  have hthreshold := Decision.u06_4_threshold_increasing q b 0 k 0 bPositive
  simpa [Decision.net, sub_eq_add_neg] using hthreshold

/-- Higher success probability need not imply greater expected cash. -/
theorem higher_win_probability_lower_expected_cash :
    (9 / 10 : ℝ) > 1 / 2 ∧
    (∫ outcome, cashOutcome outcome 1 0 0 ∂bernoulliMeasure (9 / 10)
      (by norm_num) (by norm_num)) <
      (∫ outcome, cashOutcome outcome 4 0 0 ∂bernoulliMeasure (1 / 2)
        (by norm_num) (by norm_num)) := by
  constructor
  · norm_num
  · rw [bernoulli_expected_cash (9 / 10) (by norm_num) (by norm_num) 1 0 0,
      bernoulli_expected_cash (1 / 2) (by norm_num) (by norm_num) 4 0 0]
    norm_num [Decision.net]

/-- Equal expected cash can yield different expected utility under a strictly
concave utility on nonnegative wealth. -/
theorem same_expected_cash_different_concave_utility :
    (∫ outcome, cashOutcome outcome 5 5 0 ∂bernoulliMeasure (1 / 2)
      (by norm_num) (by norm_num)) = 5 ∧
    (∫ outcome, cashOutcome outcome 10 0 0 ∂bernoulliMeasure (1 / 2)
      (by norm_num) (by norm_num)) = 5 ∧
    (∀ outcome, 0 ≤ (0 + cashOutcome outcome 5 5 0) ∧
      0 ≤ (0 + cashOutcome outcome 10 0 0)) ∧
    (∫ outcome, Real.sqrt (0 + cashOutcome outcome 10 0 0)
      ∂bernoulliMeasure (1 / 2) (by norm_num) (by norm_num)) <
      (∫ outcome, Real.sqrt (0 + cashOutcome outcome 5 5 0)
        ∂bernoulliMeasure (1 / 2) (by norm_num) (by norm_num)) := by
  have hJensen := Real.strictConcaveOn_sqrt.2
    (show (0 : ℝ) ∈ Set.Ici 0 by norm_num)
    (show (10 : ℝ) ∈ Set.Ici 0 by norm_num)
    (by norm_num : (0 : ℝ) ≠ 10)
    (a := (1 / 2 : ℝ)) (b := (1 / 2 : ℝ))
    (by norm_num) (by norm_num) (by norm_num)
  norm_num at hJensen
  have hDomain : ∀ outcome, 0 ≤ (0 + cashOutcome outcome 5 5 0) ∧
      0 ≤ (0 + cashOutcome outcome 10 0 0) := by
    intro outcome
    cases outcome <;> norm_num [cashOutcome]
  have hRiskyUtility :
      (∫ outcome, Real.sqrt (0 + cashOutcome outcome 10 0 0)
        ∂bernoulliMeasure (1 / 2) (by norm_num) (by norm_num)) =
        (1 / 2 : ℝ) * Real.sqrt 10 + (1 / 2 : ℝ) * Real.sqrt 0 := by
    rw [bernoulli_expected_value (1 / 2) (by norm_num) (by norm_num)
      (fun outcome => Real.sqrt (0 + cashOutcome outcome 10 0 0))]
    simp [cashOutcome]
  have hSureUtility :
      (∫ outcome, Real.sqrt (0 + cashOutcome outcome 5 5 0)
        ∂bernoulliMeasure (1 / 2) (by norm_num) (by norm_num)) = Real.sqrt 5 := by
    rw [bernoulli_expected_value (1 / 2) (by norm_num) (by norm_num)
      (fun outcome => Real.sqrt (0 + cashOutcome outcome 5 5 0))]
    simp [cashOutcome]
  refine ⟨?_, ?_, hDomain, ?_⟩
  · rw [bernoulli_expected_cash (1 / 2) (by norm_num) (by norm_num) 5 5 0]
    norm_num [Decision.net]
  · rw [bernoulli_expected_cash (1 / 2) (by norm_num) (by norm_num) 10 0 0]
    norm_num [Decision.net]
  · rw [hRiskyUtility, hSureUtility]
    nlinarith [hJensen]

end JurisLean.Candidates.U06_2OriginalExpectedUtilityInstances20261101
