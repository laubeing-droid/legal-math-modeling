  ("JurisLean.FullMath.Acceptance.gap_X08", "JurisLean.FullMath.Contracts.gap_X08"),
  ("JurisLean.FullMath.Acceptance.gap_X09", "JurisLean.FullMath.Contracts.gap_X09"),
  ("JurisLean.FullMath.Acceptance.gap_X10", "JurisLean.FullMath.Contracts.gap_X10"),
  ("JurisLean.FullMath.Acceptance.root_GENERIC_FINITE", "JurisLean.FullMath.Contracts.root_GENERIC_FINITE"),
  ("JurisLean.FullMath.Acceptance.root_SYMBOLIC_EXACT", "JurisLean.FullMath.Contracts.root_SYMBOLIC_EXACT"),
  ("JurisLean.FullMath.Acceptance.root_STATISTICAL_COMPOSITION", "JurisLean.FullMath.Contracts.root_STATISTICAL_COMPOSITION"),
  ("JurisLean.FullMath.Acceptance.root_CIVIL", "JurisLean.FullMath.Contracts.root_CIVIL"),
  ("JurisLean.FullMath.Acceptance.root_CRIMINAL", "JurisLean.FullMath.Contracts.root_CRIMINAL"),
  ("JurisLean.FullMath.Acceptance.root_ADMINISTRATIVE", "JurisLean.FullMath.Contracts.root_ADMINISTRATIVE"),
  ("JurisLean.FullMath.Acceptance.root_DOCUMENT_DELIVERY", "JurisLean.FullMath.Contracts.root_DOCUMENT_DELIVERY")]
  let env ← getEnv
  let mut rows : Array Json := #[]
  for (name, info) in env.constants.toList do
    if name.toString.startsWith "JurisLean." then
      match info with
      | .thmInfo ti =>
        let axs ← Lean.collectAxioms name
        let typ ← liftTermElabM <| Meta.ppExpr ti.type
        let contract := (required.find? (fun p => p.1 == name.toString)).map Prod.snd
        rows := rows.push (Json.mkObj [
          ("name", Json.str name.toString), ("kind", Json.str "theorem"),
          ("type", Json.str typ.pretty),
          ("axioms", Json.arr (axs.map (fun n => Json.str n.toString))),
          ("dependencies", Json.arr (ti.value.getUsedConstants.map (fun n => Json.str n.toString))),
          ("contract", match contract with | some c => Json.str c | none => Json.null),
          ("typecheck", Json.str "LEAN_ASSIGNMENT_ELABORATED"),
          ("proof_form", Json.str "SEE_REQUIRED_CONTRACT_NOT_INFERRED_FROM_NAME")])
      | _ => pure ()
  liftIO <| IO.println ("FULL_MATH_ENV_JSON=" ++ (Json.arr rows).compress)
